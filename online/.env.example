# Local development defaults to an explicit template host.
PORT=3001
GOD_PROVIDER=template
GOD_ALLOW_PAID_CALLS=false
GOD_MAX_CALLS=12
GOD_MAX_TOKENS=600
GOD_NATURAL_REQUIRED=true
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Real hosting requires your server-side key, provider=deepseek and paid=true.
# unlimited is an explicit opt-in; it retains the cumulative production count.
